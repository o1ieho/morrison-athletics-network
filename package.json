{
  "name": "ssn-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\"",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:local": "scripts/local-db.sh",
    "test:db": "scripts/local-db.sh && psql -X -q -o /dev/null -v ON_ERROR_STOP=1 -d ${SSN_TEST_DB:-ssn_pilot_test} -f supabase/local/tests.sql",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "dev:demo": "NEXT_PUBLIC_SSN_DEMO=1 next dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.87.1",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": "22.x"
  }
}
